# Copy to .env beside docker-compose.yml; Compose reads it for its variables.

# Start NPC speech with the stack: voice-model (Maya1 on the GPU, 127.0.0.1:5309) and voice
# (127.0.0.1:5308). Leave it out on machines without /dev/dri; Engine runs without voice.
COMPOSE_PROFILES=voice

# Machine model store holding the voice GGUF, and the file inside it.
# URBE_GGUF_DIR=~/models/gguf
# URBE_VOICE_MODEL=maya1/maya1-q4_k_m.gguf

# Host groups that own /dev/dri (getent group render video).
# RENDER_GID=990
# VIDEO_GID=44

# Voice service Engine calls, its cache cap in MiB and the accents speakers draw from.
# VOICE_BASE_URL=http://voice:8080
# VOICE_CACHE_MAX_MB=512
# VOICE_ACCENTS=American accent,British accent

# OpenAI-compatible model server for NPC dialog (Engine) and story authoring (Quests).
# LLM_BASE_URL=http://host.docker.internal:8080/v1
# LLM_MODEL=
# LLM_API_KEY=

# Character, animation and vehicle packs Engine serves.
# URBE_MODELS_DIR=~/models/quaternius
